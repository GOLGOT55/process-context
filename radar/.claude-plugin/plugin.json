{
  "name": "radar",
  "version": "2.2.0",
  "description": "Radar: what Claude is doing, live (plan, actions, files, safety guard) in a right-hand panel, a Context card above the prompt (context, cost, 5-hour and weekly limits), and an economy mode (short answers, minimal code, auto-compaction at 400k, smart skill selection).",
  "author": {
    "name": "GOLGOT55",
    "url": "https://github.com/GOLGOT55"
  },
  "license": "MIT",
  "repository": "https://github.com/GOLGOT55/radar",
  "keywords": [
    "progress",
    "panel",
    "context",
    "usage",
    "limits",
    "economy"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "showSession": {
      "type": "boolean",
      "title": "Session chip",
      "description": "Show session cost and duration.",
      "default": true
    },
    "showFiveHour": {
      "type": "boolean",
      "title": "5h chip",
      "description": "Show the 5-hour limit.",
      "default": true
    },
    "showWeek": {
      "type": "boolean",
      "title": "Week chip",
      "description": "Show the weekly limit.",
      "default": true
    },
    "showBars": {
      "type": "boolean",
      "title": "Bars",
      "description": "Show the gauges.",
      "default": true
    },
    "showPace": {
      "type": "boolean",
      "title": "Pace",
      "description": "Show the pace (+/−) against the limit.",
      "default": true
    },
    "showReset": {
      "type": "boolean",
      "title": "Reset time",
      "description": "Show when each limit resets.",
      "default": true
    },
    "sessionLabel": {
      "type": "string",
      "title": "Session label",
      "description": "Label of the session chip.",
      "default": "S"
    },
    "fiveHourLabel": {
      "type": "string",
      "title": "5h label",
      "description": "Label of the 5-hour chip.",
      "default": "5h"
    },
    "weekLabel": {
      "type": "string",
      "title": "Week label",
      "description": "Label of the weekly chip.",
      "default": "Week"
    },
    "refreshSeconds": {
      "type": "number",
      "title": "Refresh (seconds)",
      "description": "How often usage is refreshed, in seconds.",
      "default": 30
    }
  }
}
