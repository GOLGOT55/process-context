{
  "name": "aiblueprint",
  "version": "1.3.1",
  "description": "Carte Contexte au-dessus de la saisie : contexte utilisé, limites 5 h et semaine, rythme et heure de remise à zéro.",
  "author": {
    "name": "GOLGOT55",
    "url": "https://github.com/GOLGOT55"
  },
  "license": "MIT",
  "repository": "https://github.com/GOLGOT55/process-context",
  "keywords": ["contexte", "usage", "limites", "bandeau"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "showSession": {
      "type": "boolean",
      "title": "Session chip",
      "description": "Show the session cost chip.",
      "default": true
    },
    "showFiveHour": {
      "type": "boolean",
      "title": "5h chip",
      "description": "Show the 5-hour session limit.",
      "default": true
    },
    "showWeek": {
      "type": "boolean",
      "title": "Week chip",
      "description": "Show the weekly limit (all models).",
      "default": true
    },
    "showBars": {
      "type": "boolean",
      "title": "Bars",
      "description": "Draw a progress bar in the 5h and Week chips.",
      "default": true
    },
    "showPace": {
      "type": "boolean",
      "title": "Pace",
      "description": "Show the +/- pace: positive means you use less than the time elapsed.",
      "default": true
    },
    "showReset": {
      "type": "boolean",
      "title": "Reset time",
      "description": "Show when each limit resets.",
      "default": true
    },
    "sessionLabel": {
      "type": "string",
      "title": "Session label",
      "description": "Label of the cost chip.",
      "default": "S"
    },
    "fiveHourLabel": {
      "type": "string",
      "title": "5h label",
      "description": "Label of the 5-hour chip.",
      "default": "5h"
    },
    "weekLabel": {
      "type": "string",
      "title": "Week label",
      "description": "Label of the weekly chip.",
      "default": "Week"
    },
    "refreshSeconds": {
      "type": "number",
      "title": "Refresh (seconds)",
      "description": "How often the band reads usage again.",
      "default": 30
    }
  }
}
